# Supabase Configuration
# Copier ces valeurs depuis Supabase > Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_anon_key_here

# JAMAIS exposer cette clé côté client — serveur uniquement
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here

# Email Configuration (Resend)
RESEND_API_KEY=your_resend_api_key_here
RESEND_VERIFIED_EMAIL=your_verified_email_here
RESEND_DOMAIN_VERIFIED=false

# App Configuration
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_WHATSAPP=212663472335
